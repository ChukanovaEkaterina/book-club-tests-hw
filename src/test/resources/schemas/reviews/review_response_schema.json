{
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "club": {
      "type": "integer"
    },
    "user": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "username": {
              "type": "string",
              "description": "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.",
              "pattern": "^[\\w.@+-]+$",
              "maxLength": 150
            }
          },
          "required": [
            "id",
            "username"
          ],
          "additionalProperties": false
        }
      ]
    },
    "review": {
      "type": "string"
    },
    "assessment": {
      "type": "integer",
      "maximum": 5,
      "minimum": 1
    },
    "readPages": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -2147483648
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "assessment",
    "club",
    "created",
    "id",
    "modified",
    "readPages",
    "review",
    "user"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
